[Unit]
Description=MeshLink Coordination Server
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60s
StartLimitBurst=3

[Service]
Type=simple
User=meshlink
Group=meshlink

ExecStart=/usr/local/bin/coord --config /etc/meshlink/coord.toml

KillSignal=SIGINT
TimeoutStopSec=15s

Restart=on-failure
RestartSec=5s

StandardOutput=journal
StandardError=journal
SyslogIdentifier=meshlink-coord

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/meshlink /etc/meshlink /run/meshlink

PrivateNetwork=no

[Install]
WantedBy=multi-user.target
